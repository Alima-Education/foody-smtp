# --- SMTP akun no-reply ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=no-reply@domain.com
SMTP_PASS=isi-app-password
MAIL_FROM="Foody <no-reply@domain.com>"

# --- Service ---
PORT=3001
API_KEY=ganti-dengan-string-acak-panjang
# Daftar origin frontend yang boleh memanggil, pisahkan koma, harus persis (skema+host+port)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Jumlah proxy di depan app (compose sudah mengisi 1 untuk nginx). Kosongkan kalau tanpa proxy.
# TRUST_PROXY=1

# --- OTP ---
OTP_SECRET=ganti-dengan-string-acak-panjang
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Batas penyalahgunaan ---
RATE_LIMIT_PER_MINUTE=20          # request ke /otp per IP per menit
OTP_REQUESTS_PER_EMAIL_PER_HOUR=5 # permintaan kode ke satu email per jam
MAIL_DAILY_LIMIT=400              # total email per hari (Gmail ±500)
